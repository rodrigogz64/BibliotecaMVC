@model IEnumerable<Autor>
@{
    ViewData["Title"] = "Autores";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h1 class="mb-0">Gestión de Autores</h1>
    <a asp-action="Create" class="btn btn-success">Nuevo autor</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-info" role="alert">
        Todavía no hay autores registrados. Use el botón <strong>Nuevo autor</strong> para agregar el primero.
    </div>
}
else
{
    <table class="table table-striped table-bordered table-hover align-middle">
        <thead class="table-dark">
            <tr>
                <th scope="col">ID</th>
                <th scope="col">Nombre</th>
                <th scope="col">Apellido</th>
                <th scope="col">Nacionalidad</th>
                <th scope="col">Fecha de Nacimiento</th>
                <th scope="col">Estado</th>
                <th scope="col">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var autor in Model)
            {
                <tr>
                    <td>@autor.Id</td>
                    <td>@autor.Nombre</td>
                    <td>@autor.Apellido</td>
                    <td>@autor.Nacionalidad</td>
                    <td>@autor.FechaNacimiento.ToString("dd/MM/yyyy")</td>
                    <td>
                        @if (autor.Activo)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </td>
                    <td>
                        <div class="d-flex gap-1">
                            <a asp-action="Details" asp-route-id="@autor.Id" class="btn btn-sm btn-info">Ver</a>
                            <a asp-action="Edit" asp-route-id="@autor.Id" class="btn btn-sm btn-primary">Editar</a>
                            <a asp-action="Delete" asp-route-id="@autor.Id" class="btn btn-sm btn-danger">Eliminar</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
