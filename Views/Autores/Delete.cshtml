@model Autor
@{
    ViewData["Title"] = "Eliminar autor";
}

<h1 class="mb-4">Eliminar autor</h1>

<div class="alert alert-warning" role="alert">
    ¿Está seguro de que desea eliminar este autor? Esta acción no se puede deshacer.
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Nombre completo</dt>
            <dd class="col-sm-8">@Model.NombreCompleto</dd>

            <dt class="col-sm-4">Nacionalidad</dt>
            <dd class="col-sm-8">@Model.Nacionalidad</dd>

            <dt class="col-sm-4">Fecha de nacimiento</dt>
            <dd class="col-sm-8">@Model.FechaNacimiento.ToString("dd/MM/yyyy")</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="d-flex gap-2 mt-4">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger">Sí, eliminar</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>
