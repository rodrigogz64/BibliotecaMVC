        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-dark fs-6 text-decoration-none">Arte</a>
        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-primary fs-6 text-decoration-none">Biografía</a>
        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-success fs-6 text-decoration-none">Derecho</a>
        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-info fs-6 text-decoration-none">Salud</a>
    </div>
</section>

@* ---------- SERVICIOS BIBLIOTECARIOS (Grid + Cards) ---------- *@
<section class="mb-5" aria-labelledby="titulo-servicios">
    <h2 id="titulo-servicios" class="h3 mb-1">Servicios bibliotecarios</h2>
    <p class="text-body-secondary mb-4">Todo lo que la biblioteca pone a tu disposición.</p>

    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
        <div class="col">
            <div class="card h-100 border-0 shadow-sm">
                <div class="card-body">
                    <span class="icono-servicio mb-3">
                        <svg xmlns="http://www.w3.org/2000/svg" width="26" height="26" viewBox="0 0 24 24" fill="none"
