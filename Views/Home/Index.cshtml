@model InicioViewModel
@{
    ViewData["Title"] = "Inicio";
}

@* ============================================================
   PÁGINA INICIO — Biblioteca Virtual

   ACTIVIDAD 1 — Flexbox: la página se organiza con las clases
   .fila-medios, .cinta-cifras, .encabezado-seccion, .grupo-acciones,
   .nube-etiquetas y .bloque-dividido (sección 3 de site.css).

   ACTIVIDAD 2 — CSS Grid: la sección "La biblioteca en un vistazo"
   usa .mosaico, una rejilla con áreas nombradas (sección 4).
   Las rejillas de novedades, servicios y autores usan .rejilla.

   ACTIVIDAD 3 — Adaptable: el mosaico pasa de 1 a 2 y a 4 columnas
   (media queries de la sección 8); el resto envuelve por sí solo.

   ACTIVIDAD 4 — Componentes: _TarjetaCifra, _TarjetaInfo,
   _TarjetaPersona y _Etiqueta, compartidos con "Acerca de".
   ============================================================ *@

@* ---------- AVISO ---------- *@
<div class="alert alert-primary alert-dismissible fade show flexible flexible--centrado flexible--compacto" role="alert">
    <svg class="icono" aria-hidden="true" focusable="false"><use href="#icono-info" /></svg>
    <div class="flexible__crece">
        <strong>Horario extendido:</strong> durante el período de exámenes la sala de lectura permanece abierta
        hasta las 22:00. ¡Aprovecha para estudiar con nosotros!
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar aviso"></button>
</div>

@* ---------- HERO (Flexbox: texto + portada en una fila que envuelve) ---------- *@
<section class="hero-inicio p-4 p-md-5 rounded-3 text-white">
    <div class="fila-medios">
        <div class="fila-medios__texto">
            <span class="badge rounded-pill text-bg-warning mb-3">Biblioteca Virtual UEES</span>
            <h1 class="display-4 fw-bold lh-sm">Miles de libros a un clic de distancia</h1>
            <p class="lead my-4">
                Consulta el catálogo, descubre nuevos autores, reserva tu próxima lectura y gestiona
                tus préstamos desde cualquier dispositivo, las 24 horas del día.
            </p>

            <form class="mb-4" asp-controller="Libros" asp-action="Index" method="get" role="search">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-0" id="etiqueta-buscar">
                        <svg class="icono" aria-hidden="true" focusable="false"><use href="#icono-lupa" /></svg>
                    </span>
                    <input type="search" name="busqueda" class="form-control border-0"
                           placeholder="Buscar por título, autor o ISBN…" aria-label="Buscar en el catálogo"
                           aria-describedby="etiqueta-buscar" />
                    <button class="btn btn-warning fw-semibold" type="submit">Buscar</button>
                </div>
            </form>

            <div class="grupo-acciones">
                <a class="btn btn-success btn-lg px-4" asp-controller="Libros" asp-action="Index">Ver catálogo</a>
                <a class="btn btn-outline-light btn-lg px-4" asp-controller="Autores" asp-action="Index">Explorar autores</a>
                <button type="button" class="btn btn-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#modalCarne">
                    Solicitar carné
                </button>
            </div>
        </div>

        <div class="fila-medios__imagen d-none d-lg-block">
            <img src="~/images/cien-anios-de-soledad.jpg" class="rounded-3 shadow-lg portada-hero"
                 alt="Portada del libro Cien años de soledad" width="260" height="347" />
        </div>
    </div>
</section>

@* ---------- CIFRAS (Flexbox + componente _TarjetaCifra) ---------- *@
<section class="seccion" aria-labelledby="titulo-cifras">
    <h2 id="titulo-cifras" class="visually-hidden">La biblioteca en cifras</h2>

    <ul class="cinta-cifras">
        @foreach (var cifra in Model.Cifras)
        {
            <li>
                <partial name="Componentes/_TarjetaCifra" model="cifra" />
            </li>
        }
    </ul>
</section>

@* ============================================================
   ACTIVIDAD 2 — SECCIÓN CON CSS GRID
   Rejilla de áreas nombradas: el orden del HTML es el orden de
   lectura y el CSS decide dónde cae cada panel en cada pantalla.
   ============================================================ *@
<section class="seccion" aria-labelledby="titulo-vistazo">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-vistazo" class="titulo-seccion">La biblioteca en un vistazo</h2>
            <p class="subtitulo-seccion">
                El libro del mes, las categorías con más ejemplares, el autor más leído y la agenda
                cultural, todo en una sola rejilla.
            </p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="AcercaDe">Conocer la biblioteca</a>
    </div>

    <div class="mosaico">

        @* --- Área "destacado": ocupa dos columnas y dos filas en escritorio --- *@
        <article class="mosaico__panel mosaico__destacado">
            <div class="fila-medios">
                <figure class="fila-medios__imagen mosaico__portada">
                    <img src="~/images/cien-anios-de-soledad.jpg" alt="Portada de Cien años de soledad" />
                </figure>
                <div class="fila-medios__texto">
                    <span class="etiqueta etiqueta--clara">Libro del mes</span>
                    <h3>Cien años de soledad</h3>
                    <p>
                        Gabriel García Márquez · 1967 · Novela. La saga de la familia Buendía en Macondo,
                        la obra cumbre del realismo mágico y la puerta de entrada a la literatura
                        latinoamericana.
                    </p>
                    <div class="grupo-acciones">
                        <a class="btn btn-light" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                        <button type="button" class="btn btn-outline-light"
                                data-bs-toggle="modal" data-bs-target="#modalCarne">Reservar</button>
                    </div>
                </div>
            </div>
        </article>

        @* --- Área "categorias" --- *@
        <article class="mosaico__panel mosaico__categorias">
            <h3>Categorías con más títulos</h3>
            <ul class="lista-datos">
                <li><span class="lista-datos__nombre">Literatura</span><span class="lista-datos__valor">1.480 títulos</span></li>
                <li><span class="lista-datos__nombre">Ciencia y tecnología</span><span class="lista-datos__valor">960 títulos</span></li>
                <li><span class="lista-datos__nombre">Historia</span><span class="lista-datos__valor">745 títulos</span></li>
                <li><span class="lista-datos__nombre">Derecho</span><span class="lista-datos__valor">610 títulos</span></li>
                <li><span class="lista-datos__nombre">Salud</span><span class="lista-datos__valor">480 títulos</span></li>
            </ul>
        </article>

        @* --- Área "autor" --- *@
        <article class="mosaico__panel mosaico__autor">
            <span class="medallon medallon--grande" aria-hidden="true">GM</span>
            <h3>Autor más leído</h3>
            <p>Gabriel García Márquez, con 312 préstamos en lo que va del año académico.</p>
            <a class="tarjeta__enlace" asp-controller="Autores" asp-action="Index">Ver todos los autores</a>
        </article>

        @* --- Área "agenda" --- *@
        <article class="mosaico__panel mosaico__agenda">
            <h3>Agenda cultural</h3>
            <ul class="agenda">
                <li>
                    <time datetime="2026-09-04">04<br />sep</time>
                    <div>
                        <span class="agenda__titulo">Club de lectura: <em>Rayuela</em></span>
                        <span class="agenda__lugar">Sala de lectura, 18:00</span>
                    </div>
                </li>
                <li>
                    <time datetime="2026-09-12">12<br />sep</time>
                    <div>
                        <span class="agenda__titulo">Taller de citación APA</span>
                        <span class="agenda__lugar">Cabina 3, 16:00</span>
                    </div>
                </li>
                <li>
                    <time datetime="2026-09-25">25<br />sep</time>
                    <div>
                        <span class="agenda__titulo">Presentación de novedades</span>
                        <span class="agenda__lugar">Hall del edificio B, 11:00</span>
                    </div>
                </li>
            </ul>
        </article>

    </div>
</section>

@* ---------- RECOMENDADOS: CARRUSEL (Flexbox dentro de cada diapositiva) ---------- *@
<section class="seccion" aria-labelledby="titulo-carrusel">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-carrusel" class="titulo-seccion">Recomendados del mes</h2>
            <p class="subtitulo-seccion">Una selección de nuestro equipo de bibliotecarios.</p>
        </div>
    </div>

    <div id="carruselDestacados" class="carousel slide carousel-dark bg-body-tertiary rounded-3 p-4 p-md-5"
         data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="0"
                    class="active" aria-current="true" aria-label="Recomendado 1"></button>
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="1"
                    aria-label="Recomendado 2"></button>
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="2"
                    aria-label="Recomendado 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="fila-medios px-md-4 pb-4">
                    <div class="fila-medios__imagen">
                        <img src="~/images/cien-anios-de-soledad.jpg" class="rounded shadow"
                             alt="Portada de Cien años de soledad" />
                    </div>
                    <div class="fila-medios__texto">
                        <span class="etiqueta etiqueta--neutro mb-2">Gabriel García Márquez</span>
                        <h3 class="h4">Cien años de soledad</h3>
                        <p>
                            La saga de la familia Buendía en el pueblo de Macondo: la obra cumbre del realismo
                            mágico y una puerta de entrada obligatoria a la literatura latinoamericana.
                        </p>
                        <div class="nube-etiquetas mb-3">
                            <span class="etiqueta etiqueta--primario">Novela</span>
                            <span class="etiqueta etiqueta--secundario">1967</span>
                            <span class="etiqueta etiqueta--exito">Disponible</span>
                        </div>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="fila-medios px-md-4 pb-4">
                    <div class="fila-medios__imagen">
                        <img src="~/images/la-casa-de-los-espiritus.jpg" class="rounded shadow"
                             alt="Portada de La casa de los espíritus" />
                    </div>
                    <div class="fila-medios__texto">
                        <span class="etiqueta etiqueta--neutro mb-2">Isabel Allende</span>
                        <h3 class="h4">La casa de los espíritus</h3>
                        <p>
                            Cuatro generaciones de la familia Trueba atraviesan un siglo de convulsiones políticas
                            y familiares. Una novela sobre la memoria, el amor y la resistencia.
                        </p>
                        <div class="nube-etiquetas mb-3">
                            <span class="etiqueta etiqueta--primario">Novela</span>
                            <span class="etiqueta etiqueta--secundario">1982</span>
                            <span class="etiqueta etiqueta--exito">Disponible</span>
                        </div>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="fila-medios px-md-4 pb-4">
                    <div class="fila-medios__imagen">
                        <img src="~/images/ficciones.jpg" class="rounded shadow" alt="Portada de Ficciones" />
                    </div>
                    <div class="fila-medios__texto">
                        <span class="etiqueta etiqueta--neutro mb-2">Jorge Luis Borges</span>
                        <h3 class="h4">Ficciones</h3>
                        <p>
                            Laberintos, bibliotecas infinitas y espejos. Los cuentos que redefinieron lo que
                            un relato breve puede llegar a ser.
                        </p>
                        <div class="nube-etiquetas mb-3">
                            <span class="etiqueta etiqueta--primario">Cuento</span>
                            <span class="etiqueta etiqueta--secundario">1944</span>
                            <span class="etiqueta etiqueta--peligro">Prestado</span>
                        </div>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>
        </div>

        @* En móvil se ocultan las flechas (ocupan el 15% de cada lado y taparían el texto);
           ahí se navega con los indicadores o deslizando el dedo. *@
        <button class="carousel-control-prev d-none d-md-flex" type="button" data-bs-target="#carruselDestacados" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next d-none d-md-flex" type="button" data-bs-target="#carruselDestacados" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</section>

@* ---------- NOVEDADES (CSS Grid automática) ---------- *@
<section class="seccion" aria-labelledby="titulo-novedades">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-novedades" class="titulo-seccion">Novedades en el catálogo</h2>
            <p class="subtitulo-seccion">Los últimos títulos incorporados al fondo bibliográfico.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Libros" asp-action="Index">Ver todos</a>
    </div>

    <div class="rejilla">
        <article class="card h-100 shadow-sm">
            <img src="~/images/rayuela.jpg" class="card-img-top object-fit-cover" height="300"
                 alt="Portada de Rayuela" />
            <div class="card-body">
                <h3 class="card-title h5">Rayuela</h3>
                <h4 class="card-subtitle h6 mb-3 text-body-secondary">Julio Cortázar</h4>
                <p class="card-text"><small class="text-body-secondary">Novela · 1963</small></p>
                <span class="etiqueta etiqueta--peligro">Prestado</span>
            </div>
            <div class="card-footer bg-transparent">
                <button type="button" class="btn btn-sm btn-info w-100"
                        data-bs-toggle="modal" data-bs-target="#modalCarne">Reservar</button>
            </div>
        </article>

        <article class="card h-100 shadow-sm">
            <img src="~/images/la-ciudad-y-los-perros.jpg" class="card-img-top object-fit-cover" height="300"
                 alt="Portada de La ciudad y los perros" />
            <div class="card-body">
                <h3 class="card-title h5">La ciudad y los perros</h3>
                <h4 class="card-subtitle h6 mb-3 text-body-secondary">Mario Vargas Llosa</h4>
                <p class="card-text"><small class="text-body-secondary">Novela · 1963</small></p>
                <span class="etiqueta etiqueta--exito">Disponible</span>
            </div>
            <div class="card-footer bg-transparent">
                <button type="button" class="btn btn-sm btn-info w-100"
                        data-bs-toggle="modal" data-bs-target="#modalCarne">Reservar</button>
            </div>
        </article>

        <article class="card h-100 shadow-sm">
            <img src="~/images/ficciones.jpg" class="card-img-top object-fit-cover" height="300"
                 alt="Portada de Ficciones" />
            <div class="card-body">
                <h3 class="card-title h5">Ficciones</h3>
                <h4 class="card-subtitle h6 mb-3 text-body-secondary">Jorge Luis Borges</h4>
                <p class="card-text"><small class="text-body-secondary">Cuento · 1944</small></p>
                <span class="etiqueta etiqueta--peligro">Prestado</span>
            </div>
            <div class="card-footer bg-transparent">
                <button type="button" class="btn btn-sm btn-info w-100"
                        data-bs-toggle="modal" data-bs-target="#modalCarne">Reservar</button>
            </div>
        </article>

        <article class="card h-100 shadow-sm">
            <img src="~/images/la-casa-de-los-espiritus.jpg" class="card-img-top object-fit-cover" height="300"
                 alt="Portada de La casa de los espíritus" />
            <div class="card-body">
                <h3 class="card-title h5">La casa de los espíritus</h3>
                <h4 class="card-subtitle h6 mb-3 text-body-secondary">Isabel Allende</h4>
                <p class="card-text"><small class="text-body-secondary">Novela · 1982</small></p>
                <span class="etiqueta etiqueta--exito">Disponible</span>
            </div>
            <div class="card-footer bg-transparent">
                <button type="button" class="btn btn-sm btn-info w-100"
                        data-bs-toggle="modal" data-bs-target="#modalCarne">Reservar</button>
            </div>
        </article>
    </div>
</section>

@* ---------- CATEGORÍAS (Flexbox + componente _Etiqueta) ---------- *@
<section class="seccion" aria-labelledby="titulo-categorias">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-categorias" class="titulo-seccion">Explora por categoría</h2>
            <p class="subtitulo-seccion">
                Nuestro fondo bibliográfico está organizado en 24 categorías temáticas.
            </p>
        </div>
    </div>

    <ul class="nube-etiquetas">
        @foreach (var categoria in Model.Categorias)
        {
            <li>
                <partial name="Componentes/_Etiqueta" model="categoria" />
            </li>
        }
    </ul>
</section>

@* ---------- SERVICIOS (CSS Grid + componente _TarjetaInfo) ---------- *@
<section class="seccion" aria-labelledby="titulo-servicios">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-servicios" class="titulo-seccion">Servicios bibliotecarios</h2>
            <p class="subtitulo-seccion">Todo lo que la biblioteca pone a tu disposición.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Home" asp-action="AcercaDe">Ver condiciones de uso</a>
    </div>

    <div class="rejilla rejilla--ancha">
        @foreach (var servicio in Model.Servicios)
        {
            <partial name="Componentes/_TarjetaInfo" model="servicio" />
        }
    </div>
</section>

@* ---------- AUTORES DESTACADOS (Flexbox: rejilla + panel lateral) ---------- *@
<section class="seccion" aria-labelledby="titulo-autores">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-autores" class="titulo-seccion">Autores destacados</h2>
            <p class="subtitulo-seccion">Los nombres más consultados del catálogo este semestre.</p>
        </div>
        <a class="btn btn-outline-primary" asp-controller="Autores" asp-action="Index">Ver todos</a>
    </div>

    <div class="bloque-dividido">
        <div class="bloque-dividido__principal">
            <div class="rejilla rejilla--estrecha">
                @foreach (var autor in Model.AutoresDestacados)
                {
                    <partial name="Componentes/_TarjetaPersona" model="autor" />
                }
            </div>
        </div>

        <div class="bloque-dividido__lateral">
            <div class="card h-100 shadow-sm">
                <div class="card-header bg-transparent fw-semibold">Los más leídos este mes</div>
                <ol class="list-group list-group-flush list-group-numbered">
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-semibold">Cien años de soledad</div>
                            <small class="text-body-secondary">Gabriel García Márquez</small>
                        </div>
                        <span class="badge text-bg-primary rounded-pill">312</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-semibold">Rayuela</div>
                            <small class="text-body-secondary">Julio Cortázar</small>
                        </div>
                        <span class="badge text-bg-primary rounded-pill">248</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-semibold">Ficciones</div>
                            <small class="text-body-secondary">Jorge Luis Borges</small>
                        </div>
                        <span class="badge text-bg-primary rounded-pill">205</span>
                    </li>
                    <li class="list-group-item d-flex justify-content-between align-items-start">
                        <div class="ms-2 me-auto">
                            <div class="fw-semibold">La casa de los espíritus</div>
                            <small class="text-body-secondary">Isabel Allende</small>
                        </div>
                        <span class="badge text-bg-primary rounded-pill">187</span>
                    </li>
                </ol>
            </div>
        </div>
    </div>
</section>

@* ---------- PREGUNTAS FRECUENTES ---------- *@
<section class="seccion" aria-labelledby="titulo-faq">
    <div class="encabezado-seccion">
        <div class="encabezado-seccion__texto">
            <h2 id="titulo-faq" class="titulo-seccion">Preguntas frecuentes</h2>
            <p class="subtitulo-seccion">Lo que más nos consultan en el mostrador de circulación.</p>
        </div>
    </div>

    <div class="accordion shadow-sm" id="acordeonFaq">
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq1" aria-expanded="true" aria-controls="faq1">
                    ¿Cómo me afilio a la biblioteca?
                </button>
            </h3>
            <div id="faq1" class="accordion-collapse collapse show" data-bs-parent="#acordeonFaq">
                <div class="accordion-body">
                    Presenta tu cédula y una foto tamaño carné en el mostrador de circulación, o llena el
                    formulario en línea desde el botón <strong>Solicitar carné</strong>. La afiliación es
                    gratuita para estudiantes y personal de la universidad.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq2" aria-expanded="false" aria-controls="faq2">
                    ¿Cuántos libros puedo llevarme a la vez?
                </button>
            </h3>
            <div id="faq2" class="accordion-collapse collapse" data-bs-parent="#acordeonFaq">
                <div class="accordion-body">
                    Hasta <strong>3 ejemplares</strong> simultáneos por 15 días. Los libros de consulta y las
                    obras de referencia solo pueden usarse dentro de la sala de lectura.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq3" aria-expanded="false" aria-controls="faq3">
                    ¿Puedo renovar un préstamo?
                </button>
            </h3>
            <div id="faq3" class="accordion-collapse collapse" data-bs-parent="#acordeonFaq">
                <div class="accordion-body">
                    Sí, una vez por 15 días adicionales, siempre que el título no esté reservado por otro
                    usuario. La renovación se hace desde el módulo de <strong>Préstamos</strong> del portal.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq4" aria-expanded="false" aria-controls="faq4">
                    ¿Qué pasa si devuelvo un libro con retraso?
                </button>
            </h3>
            <div id="faq4" class="accordion-collapse collapse" data-bs-parent="#acordeonFaq">
                <div class="accordion-body">
                    Se suspende el derecho de préstamo un día por cada día de retraso. En caso de pérdida o
                    daño, el usuario debe reponer el ejemplar con uno de la misma edición.
                </div>
            </div>
        </div>

        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse"
                        data-bs-target="#faq5" aria-expanded="false" aria-controls="faq5">
                    ¿Cuál es el horario de atención?
                </button>
            </h3>
            <div id="faq5" class="accordion-collapse collapse" data-bs-parent="#acordeonFaq">
                <div class="accordion-body">
                    De lunes a viernes de 08:00 a 20:00 y sábados de 09:00 a 14:00. En época de exámenes la
                    sala de lectura extiende su horario hasta las 22:00.
                </div>
            </div>
        </div>
    </div>
</section>

