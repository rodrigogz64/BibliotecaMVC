                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------- AUTORES DESTACADOS (Grid + Cards + List group) ---------- *@
<section class="mb-5" aria-labelledby="titulo-autores">
    <div class="d-flex flex-wrap gap-2 justify-content-between align-items-center mb-4">
        <h2 id="titulo-autores" class="h3 mb-0">Autores destacados</h2>
        <a class="btn btn-outline-primary" asp-controller="Autores" asp-action="Index">Ver todos</a>
    </div>

    <div class="row g-4">
        <div class="col-lg-8">
            <div class="row row-cols-1 row-cols-md-3 g-4">
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <span class="avatar-autor mb-3">GM</span>
                            <h3 class="card-title h6 mb-1">Gabriel García Márquez</h3>
                            <p class="card-text"><small class="text-body-secondary">Colombia · 1927</small></p>
                            <span class="badge bg-success">Activo</span>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <span class="avatar-autor mb-3">IA</span>
                            <h3 class="card-title h6 mb-1">Isabel Allende</h3>
                            <p class="card-text"><small class="text-body-secondary">Chile · 1942</small></p>
                            <span class="badge bg-success">Activo</span>
                        </div>
                    </div>
                </div>
                <div class="col">
                    <div class="card h-100 border-0 shadow-sm text-center">
                        <div class="card-body">
                            <span class="avatar-autor mb-3">MV</span>
                            <h3 class="card-title h6 mb-1">Mario Vargas Llosa</h3>
                            <p class="card-text"><small class="text-body-secondary">Perú · 1936</small></p>
                            <span class="badge bg-success">Activo</span>
                        </div>
                    </div>
                </div>
            </div>
