    <p class="text-body-secondary mb-3">Nuestro fondo bibliográfico está organizado en 24 categorías temáticas.</p>
    <div class="d-flex flex-wrap gap-2">
        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-primary fs-6 text-decoration-none">Novela</a>
        <a asp-controller="Home" asp-action="Categorias" class="badge rounded-pill text-bg-success fs-6 text-decoration-none">Poesía</a>
