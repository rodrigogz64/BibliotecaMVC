@{
    ViewData["Title"] = "Inicio";
}

@* ============================================================
   ACTIVIDAD 1 y 3 — Página Inicio con Bootstrap 5, temática de
   Biblioteca Virtual (libros, autores, categorías y servicios).
   ACTIVIDAD 5 — Componentes extra: Carousel, Accordion, Modal,
   Alerts y Badges.
   ============================================================ *@

@* ---------- COMPONENTE: ALERT (descartable) ---------- *@
<div class="alert alert-primary alert-dismissible fade show d-flex align-items-center gap-3" role="alert">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none"
         stroke="currentColor" stroke-width="2" stroke-linecap="round" class="flex-shrink-0" aria-hidden="true">
        <circle cx="12" cy="12" r="10" />
        <path d="M12 16v-4M12 8h.01" />
    </svg>
    <div>
        <strong>Horario extendido:</strong> durante el período de exámenes la sala de lectura permanece abierta
        hasta las 22:00. ¡Aprovecha para estudiar con nosotros!
    </div>
    <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar aviso"></button>
</div>

@* ---------- SECCIÓN HERO (Grid + Botones + Input group) ---------- *@
<section class="hero-inicio p-4 p-md-5 mb-5 rounded-3 text-white">
    <div class="row align-items-center g-4 position-relative">
        <div class="col-lg-7">
            <span class="badge rounded-pill text-bg-warning mb-3">Biblioteca Virtual UEES</span>
            <h1 class="display-4 fw-bold lh-sm">Miles de libros a un clic de distancia</h1>
            <p class="lead my-4">
                Consulta el catálogo, descubre nuevos autores, reserva tu próxima lectura y gestiona
                tus préstamos desde cualquier dispositivo, las 24 horas del día.
            </p>

            <form class="mb-4" asp-controller="Libros" asp-action="Index" method="get" role="search">
                <div class="input-group input-group-lg">
                    <span class="input-group-text bg-white border-0" id="etiqueta-buscar">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
                             stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
                            <circle cx="11" cy="11" r="8" />
                            <path d="m21 21-4.3-4.3" />
                        </svg>
                    </span>
                    <input type="search" name="busqueda" class="form-control border-0"
                           placeholder="Buscar por título, autor o ISBN…" aria-label="Buscar en el catálogo"
                           aria-describedby="etiqueta-buscar" />
                    <button class="btn btn-warning fw-semibold" type="submit">Buscar</button>
                </div>
            </form>

            <div class="d-grid gap-2 d-sm-flex flex-sm-wrap">
                <a class="btn btn-success btn-lg px-4" asp-controller="Libros" asp-action="Index">Ver catálogo</a>
                <a class="btn btn-outline-light btn-lg px-4" asp-controller="Autores" asp-action="Index">Explorar autores</a>
                <button type="button" class="btn btn-light btn-lg px-4" data-bs-toggle="modal" data-bs-target="#modalCarne">
                    Solicitar carné
                </button>
            </div>
        </div>

        <div class="col-lg-5 d-none d-lg-block text-center">
            <img src="~/images/cien-anios-de-soledad.jpg" class="img-fluid rounded-3 shadow-lg portada-hero"
                 alt="Portada del libro Cien años de soledad" width="260" />
        </div>
    </div>
</section>

@* ---------- ESTADÍSTICAS (Grid + Cards) ---------- *@
<section class="mb-5" aria-labelledby="titulo-cifras">
    <h2 id="titulo-cifras" class="visually-hidden">La biblioteca en cifras</h2>
    <div class="row row-cols-2 row-cols-md-4 g-3 text-center">
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="display-6 fw-bold text-primary mb-0">5.280</p>
                    <p class="text-body-secondary mb-0">Libros en catálogo</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="display-6 fw-bold text-primary mb-0">1.140</p>
                    <p class="text-body-secondary mb-0">Autores registrados</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="display-6 fw-bold text-primary mb-0">24</p>
                    <p class="text-body-secondary mb-0">Categorías</p>
                </div>
            </div>
        </div>
        <div class="col">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <p class="display-6 fw-bold text-primary mb-0">3.900</p>
                    <p class="text-body-secondary mb-0">Socios activos</p>
                </div>
            </div>
        </div>
    </div>
</section>

@* ---------- COMPONENTE: CAROUSEL ---------- *@
<section class="mb-5" aria-labelledby="titulo-carrusel">
    <h2 id="titulo-carrusel" class="h3 mb-1">Recomendados del mes</h2>
    <p class="text-body-secondary mb-4">Una selección de nuestro equipo de bibliotecarios.</p>

    <div id="carruselDestacados" class="carousel slide carousel-dark bg-body-tertiary rounded-3 p-4 p-md-5"
         data-bs-ride="carousel">
        <div class="carousel-indicators">
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="0"
                    class="active" aria-current="true" aria-label="Recomendado 1"></button>
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="1"
                    aria-label="Recomendado 2"></button>
            <button type="button" data-bs-target="#carruselDestacados" data-bs-slide-to="2"
                    aria-label="Recomendado 3"></button>
        </div>

        <div class="carousel-inner">
            <div class="carousel-item active">
                <div class="row g-4 align-items-center px-md-5 pb-4">
                    <div class="col-8 col-sm-5 col-md-4 mx-auto mx-md-0">
                        <img src="~/images/cien-anios-de-soledad.jpg" class="img-fluid rounded shadow"
                             alt="Portada de Cien años de soledad" />
                    </div>
                    <div class="col-md-8">
                        <span class="badge text-bg-secondary mb-2">Gabriel García Márquez</span>
                        <h3 class="h4">Cien años de soledad</h3>
                        <p class="mb-3">
                            La saga de la familia Buendía en el pueblo de Macondo: la obra cumbre del realismo
                            mágico y una puerta de entrada obligatoria a la literatura latinoamericana.
                        </p>
                        <p class="mb-3">
                            <span class="badge rounded-pill text-bg-primary">Novela</span>
                            <span class="badge rounded-pill text-bg-light text-dark">1967</span>
                            <span class="badge rounded-pill bg-success">Disponible</span>
                        </p>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="row g-4 align-items-center px-md-5 pb-4">
                    <div class="col-8 col-sm-5 col-md-4 mx-auto mx-md-0">
                        <img src="~/images/la-casa-de-los-espiritus.jpg" class="img-fluid rounded shadow"
                             alt="Portada de La casa de los espíritus" />
                    </div>
                    <div class="col-md-8">
                        <span class="badge text-bg-secondary mb-2">Isabel Allende</span>
                        <h3 class="h4">La casa de los espíritus</h3>
                        <p class="mb-3">
                            Cuatro generaciones de la familia Trueba atraviesan un siglo de convulsiones políticas
                            y familiares. Una novela sobre la memoria, el amor y la resistencia.
                        </p>
                        <p class="mb-3">
                            <span class="badge rounded-pill text-bg-primary">Novela</span>
                            <span class="badge rounded-pill text-bg-light text-dark">1982</span>
                            <span class="badge rounded-pill bg-success">Disponible</span>
                        </p>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>

            <div class="carousel-item">
                <div class="row g-4 align-items-center px-md-5 pb-4">
                    <div class="col-8 col-sm-5 col-md-4 mx-auto mx-md-0">
                        <img src="~/images/ficciones.jpg" class="img-fluid rounded shadow"
                             alt="Portada de Ficciones" />
                    </div>
                    <div class="col-md-8">
                        <span class="badge text-bg-secondary mb-2">Jorge Luis Borges</span>
                        <h3 class="h4">Ficciones</h3>
                        <p class="mb-3">
                            Laberintos, bibliotecas infinitas y espejos. Los cuentos que redefinieron lo que
                            un relato breve puede llegar a ser.
                        </p>
                        <p class="mb-3">
                            <span class="badge rounded-pill text-bg-primary">Cuento</span>
                            <span class="badge rounded-pill text-bg-light text-dark">1944</span>
                            <span class="badge rounded-pill bg-danger">Prestado</span>
                        </p>
                        <a class="btn btn-primary" asp-controller="Libros" asp-action="Index">Ver en el catálogo</a>
                    </div>
                </div>
            </div>
        </div>

        @* En móvil se ocultan las flechas (ocupan el 15% de cada lado y taparían el texto);
           ahí se navega con los indicadores o deslizando el dedo. *@
        <button class="carousel-control-prev d-none d-md-flex" type="button" data-bs-target="#carruselDestacados" data-bs-slide="prev">
            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Anterior</span>
        </button>
        <button class="carousel-control-next d-none d-md-flex" type="button" data-bs-target="#carruselDestacados" data-bs-slide="next">
            <span class="carousel-control-next-icon" aria-hidden="true"></span>
            <span class="visually-hidden">Siguiente</span>
        </button>
    </div>
</section>

