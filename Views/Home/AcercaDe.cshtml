@model AcercaDeViewModel
@{
    ViewData["Title"] = "Acerca de";
}

@* ============================================================
   PÁGINA "ACERCA DE" — Biblioteca Virtual

   Construida con HTML5 semántico (article, header, nav, section,
   aside, figure, blockquote, time, address, details, dl, footer) y
   estilizada con CSS3 propio desde wwwroot/css/site.css. No se usan
   componentes de Bootstrap: todo el diseño sale de las clases .acerca-*
   y de los sistemas compartidos de flexbox, grid y componentes.

   ACTIVIDAD 4 — Componentes visuales reutilizables, definidos en
   Views/Shared/Componentes/ y usados también en la página Inicio:

     _TarjetaCifra.cshtml    → las cifras de la cabecera
     _TarjetaInfo.cshtml     → misión, visión y valores
     _TarjetaPersona.cshtml  → el equipo de la biblioteca
     _Etiqueta.cshtml        → los chips de estado y categoría

   ACTIVIDAD 3 — Adaptable: .cinta-cifras y .acerca-columnas envuelven
   solas, y .rejilla decide cuántas columnas caben en cada pantalla.
   ============================================================ *@

<article class="acerca">

    @* ---------- ENCABEZADO (Flexbox + componente _TarjetaCifra) ---------- *@
    <header class="acerca-hero">
        <p class="acerca-kicker">Biblioteca Virtual UEES</p>
        <h1 class="acerca-titulo">Un lugar donde los libros encuentran lectores</h1>
        <p class="acerca-lead">
            Somos una biblioteca universitaria que combina el fondo bibliográfico tradicional con un
            catálogo digital abierto. Nuestro propósito es que cualquier persona de la comunidad pueda
            encontrar, leer y llevarse el libro que necesita, esté donde esté.
        </p>

        <ul class="cinta-cifras cinta-cifras--clara">
            @foreach (var cifra in Model.Cifras)
            {
                <li>
                    <partial name="Componentes/_TarjetaCifra" model="cifra" />
                </li>
            }
        </ul>
    </header>

    @* ---------- ÍNDICE DE CONTENIDO ---------- *@
    <nav class="acerca-indice" aria-label="Contenido de la página">
        <h2>En esta página</h2>
        <ol>
            <li><a href="#historia">Nuestra historia</a></li>
            <li><a href="#mision">Misión, visión y valores</a></li>
            <li><a href="#colecciones">Colecciones y categorías</a></li>
            <li><a href="#servicios">Servicios bibliotecarios</a></li>
            <li><a href="#equipo">Nuestro equipo</a></li>
            <li><a href="#contacto">Contacto y horarios</a></li>
        </ol>
    </nav>

    @* ---------- HISTORIA ---------- *@
    <section id="historia" class="seccion">
        <h2 class="titulo-seccion">Nuestra historia</h2>
        <p>
            La biblioteca abrió sus puertas en <time datetime="2005">2005</time> con poco más de
            ochocientos volúmenes donados por docentes fundadores. Dos décadas después conserva la misma
            idea que la puso en marcha: que el acceso al conocimiento no debería depender del bolsillo
            de nadie.
        </p>

        <ol class="acerca-linea-tiempo">
            <li>
                <time datetime="2005">2005</time>
                <h3>Fundación</h3>
                <p>Se inaugura la sala de lectura con 800 volúmenes y un solo bibliotecario.</p>
            </li>
            <li>
                <time datetime="2011">2011</time>
                <h3>Primer catálogo informatizado</h3>
                <p>Se cataloga el fondo completo y se abre la consulta en línea desde el campus.</p>
            </li>
            <li>
                <time datetime="2018">2018</time>
                <h3>Colección digital</h3>
                <p>Se suman 2.000 libros electrónicos y el acceso remoto a bases de datos académicas.</p>
            </li>
            <li>
                <time datetime="2026">2026</time>
                <h3>Biblioteca Virtual</h3>
                <p>Se lanza este portal, que unifica catálogo, préstamos, reservas y actividades culturales.</p>
            </li>
        </ol>
    </section>

    @* ---------- MISIÓN, VISIÓN Y VALORES (CSS Grid + componente _TarjetaInfo) ---------- *@
    <section id="mision" class="seccion">
        <h2 class="titulo-seccion">Misión, visión y valores</h2>
        <p class="subtitulo-seccion">
            Las tres ideas que ordenan el trabajo diario de la biblioteca.
        </p>

        <div class="rejilla mt-4">
            @foreach (var principio in Model.Principios)
            {
                <partial name="Componentes/_TarjetaInfo" model="principio" />
            }
        </div>

        <blockquote class="acerca-cita">
            <p>Siempre imaginé que el Paraíso sería algún tipo de biblioteca.</p>
            <footer><cite>Jorge Luis Borges</cite></footer>
        </blockquote>
    </section>

    @* ---------- COLECCIONES ---------- *@
    <section id="colecciones" class="seccion">
        <h2 class="titulo-seccion">Colecciones y categorías</h2>
        <p class="subtitulo-seccion">
            El fondo está organizado en 24 categorías temáticas. Estas son las cinco con mayor número de
            ejemplares y de préstamos durante el último año académico.
        </p>

        <div class="acerca-columnas">
            <figure class="acerca-figura">
                <img src="~/images/rayuela.jpg" alt="Portada de Rayuela, de Julio Cortázar" />
                <figcaption>
                    <em>Rayuela</em> (1963), de Julio Cortázar, uno de los títulos más solicitados de la
                    colección de narrativa latinoamericana.
                </figcaption>
            </figure>

            <dl class="acerca-definiciones">
                <dt>Literatura</dt>
                <dd>Narrativa, poesía, teatro y ensayo literario. Es la colección más consultada, con 1.480 títulos.</dd>

                <dt>Ciencia y tecnología</dt>
                <dd>Matemáticas, física, computación e ingeniería, con reposición anual de las ediciones vigentes.</dd>

                <dt>Historia y ciencias sociales</dt>
                <dd>Historia del Ecuador y de América Latina, sociología, economía y ciencia política.</dd>

                <dt>Derecho</dt>
                <dd>Códigos actualizados, jurisprudencia y doctrina, en préstamo restringido a sala de lectura.</dd>

                <dt>Salud</dt>
                <dd>Medicina, enfermería y nutrición, más el acceso a revistas indexadas del área.</dd>
            </dl>
        </div>

        <aside class="acerca-dato">
            <h3>¿Sabías que…?</h3>
            <p>
                El libro más antiguo del fondo es una edición de <em>Don Quijote de la Mancha</em> de
                <time datetime="1911">1911</time>, donada por la familia de un docente fundador. Se conserva
                en la sala de fondo reservado y solo se consulta con cita previa.
            </p>
        </aside>
    </section>

    @* ---------- SERVICIOS ----------
       Misma lista que muestra la página Inicio como tarjetas: aquí se presenta
       como desplegables <details> con las condiciones de uso. *@
    <section id="servicios" class="seccion">
        <h2 class="titulo-seccion">Servicios bibliotecarios</h2>
        <p class="subtitulo-seccion">Despliega cada servicio para conocer sus condiciones de uso.</p>

        <div class="acerca-servicios">
            @foreach (var servicio in Model.Servicios)
            {
                <details>
                    <summary>
                        @if (servicio.TieneIcono)
                        {
                            <svg class="icono" aria-hidden="true" focusable="false"><use href="#icono-@servicio.Icono" /></svg>
                        }
                        @servicio.Titulo
                    </summary>
                    <p>@servicio.Descripcion</p>
                </details>
            }
        </div>
    </section>

    @* ---------- EQUIPO (CSS Grid + componente _TarjetaPersona) ---------- *@
    <section id="equipo" class="seccion">
        <h2 class="titulo-seccion">Nuestro equipo</h2>
        <p class="subtitulo-seccion">
            Ocho personas sostienen el trabajo diario de catalogación, atención y difusión.
        </p>

        <ul class="rejilla rejilla--lista mt-4">
            @foreach (var persona in Model.Equipo)
            {
                <li>
                    <partial name="Componentes/_TarjetaPersona" model="persona" />
                </li>
            }
        </ul>
    </section>

    @* ---------- CONTACTO Y HORARIOS ---------- *@
    <section id="contacto" class="seccion">
        <h2 class="titulo-seccion">Contacto y horarios</h2>

        <div class="acerca-columnas">
            <address class="acerca-direccion">
                <span class="flexible flexible--centrado flexible--compacto mb-2">
                    <svg class="icono" aria-hidden="true" focusable="false"><use href="#icono-mapa" /></svg>
                    <strong>Biblioteca Virtual UEES</strong>
                </span>
                Campus Universitario, edificio B, planta baja<br />
                Km 2,5 vía La Puntilla — Samborondón, Ecuador<br />
                <a href="tel:+59342835630">+593 4 283 5630</a><br />
                <a href="mailto:biblioteca@@uees.edu.ec">biblioteca@@uees.edu.ec</a>
            </address>

            <table class="acerca-horarios">
                <caption>
                    <span class="flexible flexible--centrado flexible--compacto">
                        <svg class="icono" aria-hidden="true" focusable="false"><use href="#icono-reloj" /></svg>
                        Horario de atención al público
                    </span>
                </caption>
                <thead>
                    <tr>
                        <th scope="col">Días</th>
                        <th scope="col">Horario</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <th scope="row">Lunes a viernes</th>
                        <td>08:00 – 20:00</td>
                    </tr>
                    <tr>
                        <th scope="row">Sábados</th>
                        <td>09:00 – 14:00</td>
                    </tr>
                    <tr>
                        <th scope="row">Domingos y feriados</th>
                        <td>Cerrado</td>
                    </tr>
                    <tr>
                        <th scope="row">Época de exámenes</th>
                        <td><mark>Sala de lectura hasta las 22:00</mark></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </section>

    @* ---------- PIE DEL ARTÍCULO ---------- *@
    <footer class="acerca-pie flexible flexible--separado">
        <p>
            Portal desarrollado con ASP.NET Core <abbr title="Modelo–Vista–Controlador">MVC</abbr>,
            HTML5, CSS3 y Bootstrap 5.
        </p>
        <p>
            Última actualización: <time datetime="2026-08-20">20 de agosto de 2026</time>
        </p>
    </footer>

</article>
